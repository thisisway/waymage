# ─────────────────────────────────────────────────────────────────────────────
# Waymage — variáveis de ambiente
#
# Copie para `.env` na raiz do repositório:  cp .env.example .env
#
# NENHUM VALOR AQUI É UM SEGREDO REAL. Os valores preenchidos servem apenas para
# o ambiente Docker local (infra/docker/docker-compose.yml). Em qualquer ambiente
# compartilhado, gere segredos novos e nunca os comite.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3333
API_PORT=3333

# ── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://waymage:waymage@localhost:5442/waymage?schema=public

# ── Redis (fila BullMQ) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6389

# ── Object storage (MinIO em dev, S3/R2 em produção) ─────────────────────────
# Bucket PRIVADO. Nunca habilite leitura anônima.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=waymage-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true para MinIO (path-style), false para AWS S3 (virtual-hosted-style)
S3_FORCE_PATH_STYLE=true
# Base pública opcional (CDN). Vazio = servir sempre por URL assinada.
S3_PUBLIC_BASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Assina o access token (JWT, 15 min). Mínimo 32 caracteres.
# Gere um valor real com: openssl rand -base64 48
# Trocar este segredo invalida todos os access tokens em circulação.
JWT_ACCESS_SECRET=dev-only-change-me-0000000000000000

# Não existe JWT_REFRESH_SECRET: o refresh token é um valor aleatório opaco, guardado no
# banco apenas como hash SHA-256, para poder ser revogado na hora (ver docs/DECISIONS.md D-020).

# `true` quando a API roda atrás de reverse proxy (EasyPanel, nginx, Cloudflare).
# Sem isto, o rate limit enxerga todos os requests vindos do IP do proxy.
TRUST_PROXY=false

# SameSite dos cookies de sessão: `lax` ou `none`.
#
# `lax` serve quando web e API compartilham o site registrável — app.dominio.com e
# api.dominio.com. Use `none` quando NÃO compartilham, o que inclui os domínios padrão do
# EasyPanel: `easypanel.host` está na Public Suffix List, então cada subdomínio conta como um
# site diferente para o browser.
#
# Errar aqui dá um sintoma traiçoeiro: o login responde 200 e todo request seguinte volta 401.
# `none` exige HTTPS nas duas pontas.
COOKIE_SAMESITE=lax

# ── Provedores de imagem ─────────────────────────────────────────────────────
# Nenhuma chave real é necessária: os dois provedores registrados são fake
# (ver docs/DECISIONS.md D-011). A escolha entre eles é do ModelRouter (blueprint 11.3);
# para forçar um, use advanced.provider na cena: "fake-rapido" ou "fake-estudio".
# Latência simulada do FakeImageProvider, em milissegundos.
FAKE_PROVIDER_LATENCY_MS=1200
# Jobs simultâneos por worker. Geração espera o provedor (pode ser alta); processamento de
# imagem é limitado por CPU (manter baixa, senão os jobs disputam os mesmos núcleos).
WORKER_CONCURRENCY=2
ASSET_CONCURRENCY=2
# Chaves reais — deixe VAZIO. Só preencha na Fase 9, e nunca comite.
IMAGE_PROVIDER_A_API_KEY=
IMAGE_PROVIDER_B_API_KEY=

# ── Observabilidade (instrumentação na Fase 11) ──────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_PROVIDER_ROUTING=false
FEATURE_MASK_EDITING=false
FEATURE_BRAND_KIT=false

# ── Frontend (exposto ao browser — nunca coloque segredo em NEXT_PUBLIC_*) ────
NEXT_PUBLIC_API_URL=http://localhost:3333
